{
  "Urls": "http://localhost:5080",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  // ===================================================================================
  //  McpDesk 自定义配置
  //  每一项都有默认值，留空即可正常运行；下方注释说明了各项的作用。
  // ===================================================================================
  "McpDesk": {
    // 访问密钥：留空表示不校验。
    // 非空时，调用 /mcp 必须带请求头 X-Api-Key: <值>。
    // 仅在本机使用建议留空；若把服务暴露到局域网，请务必设置强随机值。
    "ApiKey": "",

    // 笔记数据目录。相对路径以程序内容根目录为基准；也可以写绝对路径，例如 D:\\McpDeskData
    "StorageRoot": "data",

    // 文件类工具（list_files / read_text_file）允许访问的根目录。
    // 留空 = 当前用户目录（C:\\Users\\<用户名>），防止 AI 误读系统其它位置。
    // 想让它访问自己的项目目录时，改成例如 "F:\\我的项目"。
    "FileSandboxRoot": "",

    // http_get 单次最多读取的字节数（约等于返回给模型的最大文本量）
    "MaxFetchBytes": 1000000,

    // 是否允许 http_get 访问本机 / 内网地址。
    // 默认 false（防 SSRF）：模型可能被网页内容诱导去访问 192.168.x.x 或 127.0.0.1 上的接口。
    // 需要调试本地服务时再临时打开。
    "AllowPrivateNetwork": false,

    // 内存中保留多少条工具调用日志（10 ~ 5000）
    "MaxLogEntries": 200
  }
}
